datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Satellite {
  id          String   @id
  name        String
  tleLine1    String
  tleLine2    String
  type        String
  launchDate  DateTime?
  updatedAt   DateTime @default(now()) @updatedAt
}
